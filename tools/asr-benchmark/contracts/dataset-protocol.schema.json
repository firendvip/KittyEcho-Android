{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/dataset-protocol-v1.json",
  "title": "KittyEcho frozen ASR dataset protocol v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "approval_status", "profile",
    "selection_authority", "target_device", "required_conditions",
    "minimum_unique_clips_per_condition", "minimum_speaker_clusters",
    "minimum_session_clusters", "minimum_joint_clusters",
    "slice_cluster_minimums", "preregistration", "required_source_kind",
    "exploration_pcm_set_sha256", "unique_pcm_required", "bootstrap_unit",
    "telemetry"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "protocol_id": {"type": "string", "pattern": "^protocol_[0-9a-f]{12}$"},
    "approval_status": {"enum": ["draft", "approved"]},
    "profile": {
      "enum": ["development_fixture", "exploration", "production_confirmation"]
    },
    "selection_authority": {
      "enum": [
        "development_screening_only", "elimination_only", "production_confirmation"
      ]
    },
    "target_device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "physical_device", "abi", "device_profile_sha256"],
      "properties": {
        "platform": {"const": "android"},
        "physical_device": {"const": true},
        "abi": {"const": "arm64-v8a"},
        "device_profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "required_conditions": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/condition"}
    },
    "minimum_unique_clips_per_condition": {"$ref": "#/$defs/condition_counts"},
    "minimum_speaker_clusters": {"type": "integer", "minimum": 1},
    "minimum_session_clusters": {"type": "integer", "minimum": 1},
    "minimum_joint_clusters": {"type": "integer", "minimum": 1},
    "slice_cluster_minimums": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 11,
      "propertyNames": {
        "enum": [
          "quiet_near", "noise", "fast", "slow", "immediate_start", "short",
          "normal_short", "long", "proper_name_number", "code_switch", "accent"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum_speakers", "minimum_sessions"],
        "properties": {
          "minimum_speakers": {"type": "integer", "minimum": 0},
          "minimum_sessions": {"type": "integer", "minimum": 0}
        }
      }
    },
    "preregistration": {
      "type": "object",
      "minProperties": 1,
      "description": "Runtime validation requires exact frozen fields for exploration or production_confirmation."
    },
    "exploration_pcm_set_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "required_source_kind": {"const": "local_target_device_recording"},
    "unique_pcm_required": {"const": true},
    "bootstrap_unit": {
      "enum": ["speaker_session_cluster", "speaker_nested_session_clip"]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_interval_ms", "sample_interval_tolerance_ms",
        "sample_interval_tolerance_fraction", "minimum_duration_seconds",
        "minimum_decode_loops", "active_decode_progress_unit"
      ],
      "properties": {
        "sample_interval_ms": {"const": 5000},
        "sample_interval_tolerance_ms": {"const": 250},
        "sample_interval_tolerance_fraction": {"const": 0.05},
        "minimum_duration_seconds": {"const": 600.0},
        "minimum_decode_loops": {"const": 2},
        "active_decode_progress_unit": {
          "const": "trusted_runner_progress_events_v1"
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "condition": {
      "enum": [
        "quiet_near", "noise", "fast", "slow", "immediate_start", "short",
        "normal_short", "long", "proper_name_number", "code_switch", "accent"
      ]
    },
    "condition_counts": {
      "type": "object",
      "minProperties": 11,
      "maxProperties": 11,
      "propertyNames": {
        "enum": [
          "quiet_near", "noise", "fast", "slow", "immediate_start", "short",
          "normal_short", "long", "proper_name_number", "code_switch", "accent"
        ]
      },
      "additionalProperties": {"type": "integer", "minimum": 1}
    }
  }
}
