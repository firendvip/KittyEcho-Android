{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/blind-run-plan-v1.json",
  "title": "KittyEcho public blind run plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "dataset_id", "pcm_contract_id", "assignments",
    "protocol_profile", "cohort_id", "cohort_model_ids_sha256",
    "formal_artifact_set_sha256", "formal_risk_acceptance_set_sha256",
    "formal_model_cohort_sha256",
    "baseline_commitment_sha256", "clip_pcm_sha256", "clip_pcm_payload_sha256",
    "randomization", "contract_fingerprints"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "dataset_id": {"type": "string", "pattern": "^dataset_[0-9a-f]{12}$"},
    "pcm_contract_id": {"const": "pcm16k-mono-s16le-v1"},
    "protocol_profile": {
      "enum": ["development_fixture", "exploration", "production_confirmation"]
    },
    "cohort_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{1,63}$"},
    "cohort_model_ids_sha256": {"$ref": "#/$defs/sha256"},
    "formal_artifact_set_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "formal_risk_acceptance_set_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "formal_model_cohort_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "assignments": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model_alias", "clip_order"],
        "properties": {
          "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
          "clip_order": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^clip_[0-9a-f]{12}$"}
          }
        }
      }
    },
    "baseline_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "clip_pcm_sha256": {"$ref": "#/$defs/hash_map"},
    "clip_pcm_payload_sha256": {"$ref": "#/$defs/hash_map"},
    "randomization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "private_map_sha256"],
      "properties": {
        "algorithm": {"const": "sha256-fisher-yates-v1"},
        "private_map_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "contract_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_sha256", "dataset_protocol_sha256", "normalization_sha256",
        "selection_config_sha256", "registry_sha256"
      ],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "dataset_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_sha256": {"$ref": "#/$defs/sha256"},
        "selection_config_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hash_map": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^clip_[0-9a-f]{12}$"},
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    }
  }
}
