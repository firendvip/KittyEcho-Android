{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/external-observer-evidence-v1.json",
  "title": "KittyEcho synthetic external ADB observer evidence contract v1",
  "description": "Development-only fixture for the future host observer. It is not evidence that ADB or a physical device was used.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observer_mode",
    "run_id",
    "model_alias",
    "observer_challenge_sha256",
    "host_clock",
    "host_resource_policy",
    "known_release",
    "attestation_observation",
    "device_identity_commitment_sha256",
    "source_receipt_commitments",
    "android_commitments",
    "repetitions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "observer_mode": {"const": "synthetic_fixture_no_adb"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
    "observer_challenge_sha256": {"$ref": "#/$defs/sha256"},
    "host_clock": {"$ref": "#/$defs/host_clock"},
    "host_resource_policy": {"$ref": "#/$defs/host_resource_policy"},
    "known_release": {"$ref": "#/$defs/known_release"},
    "attestation_observation": {
      "$ref": "#/$defs/attestation_observation"
    },
    "device_identity_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "source_receipt_commitments": {
      "$ref": "#/$defs/source_receipt_commitments"
    },
    "android_commitments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "repetitions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/repetition"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "known_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "version_code",
        "apk_sha256",
        "app_signing_cert_sha256",
        "runner_build_sha256"
      ],
      "properties": {
        "package_name": {"type": "string", "minLength": 1},
        "version_code": {"type": "integer", "minimum": 1},
        "apk_sha256": {"$ref": "#/$defs/sha256"},
        "app_signing_cert_sha256": {"$ref": "#/$defs/sha256"},
        "runner_build_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "boot_id_sha256"],
      "properties": {
        "source": {"const": "host_monotonic_clock_v1"},
        "boot_id_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host_resource_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_physical_ram_bytes",
        "max_process_memory_bytes"
      ],
      "properties": {
        "device_physical_ram_bytes": {"type": "integer", "minimum": 1},
        "max_process_memory_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "attestation_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificate_chain_verified",
        "hardware_key_verified",
        "attestation_security_level",
        "challenge_matches",
        "application_matches",
        "locked_verified_boot",
        "attestation_envelope_raw_sha256"
      ],
      "properties": {
        "certificate_chain_verified": {"const": true},
        "hardware_key_verified": {"const": true},
        "attestation_security_level": {
          "enum": ["trusted_environment", "strongbox"]
        },
        "challenge_matches": {"const": true},
        "application_matches": {"const": true},
        "locked_verified_boot": {"const": true},
        "attestation_envelope_raw_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_receipt_commitments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_a_decoder_plan_receipt_commit_sha256",
        "accuracy_payload_receipt_commit_sha256",
        "engineering_receipt_commit_sha256",
        "android_attestation_receipt_commit_sha256"
      ],
      "properties": {
        "phase_a_decoder_plan_receipt_commit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "accuracy_payload_receipt_commit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "engineering_receipt_commit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "android_attestation_receipt_commit_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "pcm_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id",
        "wav_file_sha256",
        "pcm_payload_sha256",
        "pcm_payload_bytes"
      ],
      "properties": {
        "clip_id": {
          "type": "string",
          "pattern": "^clip_[0-9a-f]{12}$"
        },
        "wav_file_sha256": {"$ref": "#/$defs/sha256"},
        "pcm_payload_sha256": {"$ref": "#/$defs/sha256"},
        "pcm_payload_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "artifact_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_role",
        "sha256",
        "size_bytes",
        "st_dev",
        "st_ino",
        "mode",
        "nlink"
      ],
      "properties": {
        "component_role": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "st_dev": {"type": "integer", "minimum": 1},
        "st_ino": {"type": "integer", "minimum": 1},
        "mode": {"type": "integer", "minimum": 1},
        "nlink": {"const": 1}
      }
    },
    "clip_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id",
        "monotonic_stop_ns",
        "monotonic_final_ns",
        "stop_to_final_ns"
      ],
      "properties": {
        "clip_id": {
          "type": "string",
          "pattern": "^clip_[0-9a-f]{12}$"
        },
        "monotonic_stop_ns": {"type": "integer", "minimum": 0},
        "monotonic_final_ns": {"type": "integer", "minimum": 1},
        "stop_to_final_ns": {"type": "integer", "minimum": 1}
      }
    },
    "memory_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monotonic_ns", "rss_bytes", "pss_bytes"],
      "properties": {
        "monotonic_ns": {"type": "integer", "minimum": 0},
        "rss_bytes": {"type": "integer", "minimum": 1},
        "pss_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "repetition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetition_index",
        "process_instance_sha256",
        "pid",
        "pid_start_ticks",
        "host_clock_boot_id_sha256",
        "clean_process_start",
        "preexisting_process_detected",
        "process_exit_observed",
        "oom_kill_count",
        "crash_count",
        "host_monotonic_start_ns",
        "host_monotonic_end_ns",
        "external_clip_timings",
        "external_memory_samples",
        "observed_peak_rss_bytes",
        "observed_peak_pss_bytes",
        "host_pcm_measurements",
        "host_artifact_measurements",
        "host_pcm_set_sha256",
        "host_artifact_set_sha256",
        "host_accuracy_output_sha256",
        "host_apk_sha256",
        "host_signing_cert_sha256",
        "host_runner_build_sha256"
      ],
      "properties": {
        "repetition_index": {"type": "integer", "minimum": 1, "maximum": 2},
        "process_instance_sha256": {"$ref": "#/$defs/sha256"},
        "pid": {"type": "integer", "minimum": 1},
        "pid_start_ticks": {"type": "integer", "minimum": 1},
        "host_clock_boot_id_sha256": {"$ref": "#/$defs/sha256"},
        "clean_process_start": {"const": true},
        "preexisting_process_detected": {"const": false},
        "process_exit_observed": {"const": true},
        "oom_kill_count": {"const": 0},
        "crash_count": {"const": 0},
        "host_monotonic_start_ns": {"type": "integer", "minimum": 0},
        "host_monotonic_end_ns": {"type": "integer", "minimum": 1},
        "external_clip_timings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/clip_timing"}
        },
        "external_memory_samples": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/memory_sample"}
        },
        "observed_peak_rss_bytes": {"type": "integer", "minimum": 1},
        "observed_peak_pss_bytes": {"type": "integer", "minimum": 1},
        "host_pcm_measurements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/pcm_measurement"}
        },
        "host_artifact_measurements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact_measurement"}
        },
        "host_pcm_set_sha256": {"$ref": "#/$defs/sha256"},
        "host_artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "host_accuracy_output_sha256": {"$ref": "#/$defs/sha256"},
        "host_apk_sha256": {"$ref": "#/$defs/sha256"},
        "host_signing_cert_sha256": {"$ref": "#/$defs/sha256"},
        "host_runner_build_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
