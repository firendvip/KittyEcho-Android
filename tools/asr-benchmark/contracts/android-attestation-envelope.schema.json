{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/android-attestation-envelope-v1.json",
  "title": "KittyEcho Android Keystore attestation envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_format",
    "signed_payload",
    "signature_algorithm",
    "signature_base64",
    "certificate_chain_der_base64"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "attestation_format": {
      "const": "android-keystore-key-attestation-v1"
    },
    "signed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "model_alias",
        "protocol_profile",
        "commitments",
        "host_challenge_sha256",
        "attestation_challenge_sha256",
        "runtime_claims"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
        "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
        "protocol_profile": {
          "enum": [
            "development_fixture",
            "exploration",
            "production_confirmation"
          ]
        },
        "commitments": {"type": "object"},
        "host_challenge_sha256": {"$ref": "#/$defs/sha256"},
        "attestation_challenge_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "physical_device",
            "emulator",
            "local_key_security_level"
          ],
          "properties": {
            "physical_device": {"type": "boolean"},
            "emulator": {"type": "boolean"},
            "local_key_security_level": {
              "enum": [
                "software",
                "trusted_environment",
                "strongbox",
                "unknown"
              ]
            }
          }
        }
      }
    },
    "signature_algorithm": {"const": "SHA256withECDSA"},
    "signature_base64": {"type": "string", "minLength": 1},
    "certificate_chain_der_base64": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
