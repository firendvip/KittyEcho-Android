{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/selection-failure-v1.json",
  "title": "KittyEcho explicit candidate failure record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "dataset_id", "model_alias",
    "public_plan_sha256", "registry_sha256", "reason_code",
    "attestation_status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "dataset_id": {"type": "string", "pattern": "^dataset_[0-9a-f]{12}$"},
    "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
    "public_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reason_code": {
      "enum": [
        "runner_failed", "oom", "crash", "decode_error",
        "resource_gate_failed", "stability_gate_failed"
      ]
    },
    "attestation_status": {
      "enum": ["development_untrusted", "phase_b_attestation_required"]
    }
  }
}
