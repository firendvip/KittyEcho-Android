{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/android-engineering-output-v2.json",
  "title": "KittyEcho Android anonymous engineering output v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "dataset_id",
    "model_alias",
    "decoder_plan_sha256",
    "accuracy_output_sha256",
    "clock_source",
    "trusted_runner_status",
    "bindings",
    "pcm_set_sha256",
    "artifact_measurements",
    "artifact_set_sha256",
    "clip_measurements",
    "runtime",
    "telemetry"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "dataset_id": {"type": "string", "pattern": "^dataset_[0-9a-f]{12}$"},
    "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
    "decoder_plan_sha256": {"$ref": "#/$defs/sha256"},
    "accuracy_output_sha256": {"$ref": "#/$defs/sha256"},
    "clock_source": {"const": "android_elapsed_realtime_nanos"},
    "trusted_runner_status": {
      "enum": [
        "phase_b_development_only",
        "phase_b_external_observer_required"
      ]
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_evidence_sha256",
        "public_plan_sha256",
        "registry_sha256",
        "normalization_sha256",
        "selection_config_sha256",
        "runner_build_sha256",
        "apk_sha256",
        "app_signing_cert_sha256",
        "device_identity_commitment_sha256"
      ],
      "properties": {
        "benchmark_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "public_plan_sha256": {"$ref": "#/$defs/sha256"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "normalization_sha256": {"$ref": "#/$defs/sha256"},
        "selection_config_sha256": {"$ref": "#/$defs/sha256"},
        "runner_build_sha256": {"$ref": "#/$defs/sha256"},
        "apk_sha256": {"$ref": "#/$defs/sha256"},
        "app_signing_cert_sha256": {"$ref": "#/$defs/sha256"},
        "device_identity_commitment_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pcm_set_sha256": {"$ref": "#/$defs/sha256"},
    "artifact_measurements": {"type": "array", "minItems": 1},
    "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "clip_measurements": {"type": "array", "minItems": 1},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_resource_bytes",
        "cold_latency_ns",
        "warm_latency_ns",
        "decode_probe_peak_rss_bytes",
        "decode_probe_peak_pss_bytes",
        "peak_rss_bytes",
        "peak_pss_bytes",
        "oom_count",
        "crash_count",
        "success_count"
      ],
      "properties": {
        "total_resource_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "cold_latency_ns": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "warm_latency_ns": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonnegative_integer"}
        },
        "decode_probe_peak_rss_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "decode_probe_peak_pss_bytes": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "peak_rss_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "peak_pss_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "oom_count": {"$ref": "#/$defs/nonnegative_integer"},
        "crash_count": {"$ref": "#/$defs/nonnegative_integer"},
        "success_count": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_interval_ms",
        "duration_ns",
        "samples",
        "summary_sha256",
        "loop_count",
        "successful_loop_count",
        "total_decoded_clip_count",
        "loop_proofs"
      ],
      "properties": {
        "sample_interval_ms": {"type": "integer", "minimum": 1},
        "duration_ns": {"$ref": "#/$defs/nonnegative_integer"},
        "samples": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "monotonic_ns",
              "rss_bytes",
              "pss_bytes",
              "thermal_status",
              "heartbeat_index",
              "runner_alive",
              "decoder_active",
              "active_clip_id",
              "active_decode_progress",
              "completed_clip_count",
              "completed_loops",
              "completed_clips_in_current_loop",
              "successful_loops",
              "last_verified_clip_id"
            ],
            "properties": {
              "monotonic_ns": {"$ref": "#/$defs/nonnegative_integer"},
              "rss_bytes": {"$ref": "#/$defs/nonnegative_integer"},
              "pss_bytes": {"$ref": "#/$defs/nonnegative_integer"},
              "thermal_status": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "heartbeat_index": {"$ref": "#/$defs/nonnegative_integer"},
              "runner_alive": {"const": true},
              "decoder_active": {"type": "boolean"},
              "active_clip_id": {"$ref": "#/$defs/nullable_clip_id"},
              "active_decode_progress": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "completed_clip_count": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "completed_loops": {"$ref": "#/$defs/nonnegative_integer"},
              "completed_clips_in_current_loop": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "successful_loops": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "last_verified_clip_id": {
                "$ref": "#/$defs/nullable_clip_id"
              }
            }
          }
        },
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "loop_count": {"type": "integer", "minimum": 2},
        "successful_loop_count": {"type": "integer", "minimum": 2},
        "total_decoded_clip_count": {
          "$ref": "#/$defs/nonnegative_integer"
        },
        "loop_proofs": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "loop_index",
              "monotonic_start_ns",
              "monotonic_end_ns",
              "ordered_clip_ids_sha256",
              "clip_count",
              "cumulative_decoded_clip_count",
              "successful"
            ],
            "properties": {
              "loop_index": {"type": "integer", "minimum": 1},
              "monotonic_start_ns": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "monotonic_end_ns": {
                "$ref": "#/$defs/nonnegative_integer"
              },
              "ordered_clip_ids_sha256": {"$ref": "#/$defs/sha256"},
              "clip_count": {"type": "integer", "minimum": 1},
              "cumulative_decoded_clip_count": {
                "type": "integer",
                "minimum": 1
              },
              "successful": {"const": true}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "clip_id": {
      "type": "string",
      "pattern": "^clip_[0-9a-f]{12}$"
    },
    "nullable_clip_id": {
      "anyOf": [
        {"$ref": "#/$defs/clip_id"},
        {"type": "null"}
      ]
    }
  }
}
