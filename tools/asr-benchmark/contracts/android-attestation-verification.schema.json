{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/android-attestation-verification-v1.json",
  "title": "KittyEcho committed Android attestation verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model_alias",
    "protocol_profile",
    "signature_verified",
    "certificate_chain_verified",
    "hardware_key_verified",
    "attestation_security_level",
    "assurance_level",
    "formal_eligible",
    "product_decision_eligible",
    "adversarial_same_uid_resistant",
    "blockers",
    "commitments",
    "accuracy_payload_receipt_commit_sha256",
    "engineering_receipt_commit_sha256",
    "phase_a_decoder_plan_receipt_commit_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
    "protocol_profile": {
      "enum": [
        "development_fixture",
        "exploration",
        "production_confirmation"
      ]
    },
    "signature_verified": {"type": "boolean"},
    "certificate_chain_verified": {"type": "boolean"},
    "hardware_key_verified": {"type": "boolean"},
    "attestation_security_level": {
      "enum": ["software", "trusted_environment", "strongbox", "unknown"]
    },
    "assurance_level": {
      "enum": ["development_signed", "engineering_trusted"]
    },
    "formal_eligible": {"const": false},
    "product_decision_eligible": {"const": false},
    "adversarial_same_uid_resistant": {"const": false},
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "commitments": {"type": "object"},
    "accuracy_payload_receipt_commit_sha256": {"$ref": "#/$defs/sha256"},
    "engineering_receipt_commit_sha256": {"$ref": "#/$defs/sha256"},
    "phase_a_decoder_plan_receipt_commit_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
