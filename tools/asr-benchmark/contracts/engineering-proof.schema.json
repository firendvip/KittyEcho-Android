{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/engineering-proof-v1.json",
  "title": "KittyEcho private Android engineering proof v1",
  "description": "Runner/engineering-role input. Never provide this document to the reference scorer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "dataset_id", "model_alias",
    "decoder_contract_id", "pcm_contract_id", "input_transform_id",
    "decoder_plan_sha256", "accuracy_output_sha256", "clip_measurements",
    "runtime", "runner_proof"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "#/$defs/run_id"},
    "dataset_id": {"$ref": "#/$defs/dataset_id"},
    "model_alias": {"$ref": "#/$defs/model_alias"},
    "decoder_contract_id": {"const": "first-layer-raw-v1"},
    "pcm_contract_id": {"const": "pcm16k-mono-s16le-v1"},
    "input_transform_id": {"const": "canonical-pcm-direct-v1"},
    "decoder_plan_sha256": {"$ref": "#/$defs/sha256"},
    "accuracy_output_sha256": {"$ref": "#/$defs/sha256"},
    "clip_measurements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clip_measurement"}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_resource_bytes", "peak_rss_bytes", "oom_count", "crash_count",
        "cold_start_ms", "warm_start_ms", "stability"
      ],
      "properties": {
        "total_resource_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "peak_rss_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "oom_count": {"$ref": "#/$defs/nonnegative_integer"},
        "crash_count": {"$ref": "#/$defs/nonnegative_integer"},
        "cold_start_ms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonnegative_number"}
        },
        "warm_start_ms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/nonnegative_number"}
        },
        "stability": {"$ref": "#/$defs/stability"}
      }
    },
    "runner_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_version", "capture_mode", "trusted_runner_status",
        "device_profile_sha256", "runner_build_sha256", "clock_source",
        "artifact_measurements", "artifact_set_sha256", "telemetry", "proof_sha256"
      ],
      "properties": {
        "proof_version": {"const": "trusted-android-runner-proof-v1"},
        "capture_mode": {"const": "trusted_android_runner"},
        "trusted_runner_status": {"const": "phase_b_required"},
        "device_profile_sha256": {"$ref": "#/$defs/sha256"},
        "runner_build_sha256": {"$ref": "#/$defs/sha256"},
        "clock_source": {"const": "android_elapsed_realtime_nanos"},
        "artifact_measurements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact_measurement"}
        },
        "artifact_set_sha256": {"$ref": "#/$defs/sha256"},
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "proof_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "dataset_id": {"type": "string", "pattern": "^dataset_[0-9a-f]{12}$"},
    "clip_id": {"type": "string", "pattern": "^clip_[0-9a-f]{12}$"},
    "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
    "nonnegative_integer": {"type": "integer", "minimum": 0},
    "nonnegative_number": {"type": "number", "minimum": 0},
    "nullable_error": {
      "type": ["string", "null"],
      "enum": [null, "oom", "crash", "decode_error"]
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_seconds", "failure_count", "completed", "max_thermal_status"
      ],
      "properties": {
        "duration_seconds": {"$ref": "#/$defs/nonnegative_number"},
        "failure_count": {"$ref": "#/$defs/nonnegative_integer"},
        "completed": {"type": "boolean"},
        "max_thermal_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "runner_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wav_file_sha256_before", "wav_file_sha256_after", "pcm_payload_sha256",
        "pcm_payload_bytes_read", "monotonic_start_ns", "monotonic_stop_ns",
        "monotonic_final_ns"
      ],
      "properties": {
        "wav_file_sha256_before": {"$ref": "#/$defs/sha256"},
        "wav_file_sha256_after": {"$ref": "#/$defs/sha256"},
        "pcm_payload_sha256": {"$ref": "#/$defs/sha256"},
        "pcm_payload_bytes_read": {"$ref": "#/$defs/nonnegative_integer"},
        "monotonic_start_ns": {"$ref": "#/$defs/nonnegative_integer"},
        "monotonic_stop_ns": {"$ref": "#/$defs/nonnegative_integer"},
        "monotonic_final_ns": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "clip_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clip_id", "pcm_sha256", "pcm_payload_sha256", "stop_to_final_ms",
        "runner_evidence", "run_state", "status", "error_code"
      ],
      "properties": {
        "clip_id": {"$ref": "#/$defs/clip_id"},
        "pcm_sha256": {"$ref": "#/$defs/sha256"},
        "pcm_payload_sha256": {"$ref": "#/$defs/sha256"},
        "stop_to_final_ms": {"$ref": "#/$defs/nonnegative_number"},
        "runner_evidence": {"$ref": "#/$defs/runner_evidence"},
        "run_state": {"enum": ["cold", "warm"]},
        "status": {"enum": ["ok", "error"]},
        "error_code": {"$ref": "#/$defs/nullable_error"}
      }
    },
    "artifact_measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "component", "bytes", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "component": {
          "enum": ["weights", "conversion", "runtime", "tokenizer"]
        },
        "bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "telemetry_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monotonic_ns", "rss_bytes", "thermal_status", "completed_loops",
        "successful_loops", "heartbeat_index", "runner_alive",
        "active_decode_progress", "completed_clip_count"
      ],
      "properties": {
        "monotonic_ns": {"$ref": "#/$defs/nonnegative_integer"},
        "rss_bytes": {"$ref": "#/$defs/nonnegative_integer"},
        "thermal_status": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "completed_loops": {"$ref": "#/$defs/nonnegative_integer"},
        "successful_loops": {"$ref": "#/$defs/nonnegative_integer"},
        "heartbeat_index": {"$ref": "#/$defs/nonnegative_integer"},
        "runner_alive": {"const": true},
        "active_decode_progress": {"$ref": "#/$defs/nonnegative_integer"},
        "completed_clip_count": {"$ref": "#/$defs/nonnegative_integer"}
      }
    },
    "loop_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loop_index", "monotonic_start_ns", "monotonic_end_ns",
        "ordered_clip_ids_sha256", "clip_count",
        "cumulative_decoded_clip_count", "successful"
      ],
      "properties": {
        "loop_index": {"type": "integer", "minimum": 1},
        "monotonic_start_ns": {"$ref": "#/$defs/nonnegative_integer"},
        "monotonic_end_ns": {"$ref": "#/$defs/nonnegative_integer"},
        "ordered_clip_ids_sha256": {"$ref": "#/$defs/sha256"},
        "clip_count": {"type": "integer", "minimum": 1},
        "cumulative_decoded_clip_count": {
          "type": "integer",
          "minimum": 1
        },
        "successful": {"type": "boolean"}
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_interval_ms", "samples", "summary_sha256", "loop_count",
        "successful_loop_count", "total_decoded_clip_count", "loop_proofs"
      ],
      "properties": {
        "sample_interval_ms": {"type": "integer", "minimum": 1},
        "samples": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/telemetry_sample"}
        },
        "summary_sha256": {"$ref": "#/$defs/sha256"},
        "loop_count": {"type": "integer", "minimum": 2},
        "successful_loop_count": {"$ref": "#/$defs/nonnegative_integer"},
        "total_decoded_clip_count": {"type": "integer", "minimum": 1},
        "loop_proofs": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/loop_proof"}
        }
      }
    }
  }
}
