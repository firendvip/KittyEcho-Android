{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordtaker.com/schemas/asr-benchmark/decoder-plan-v1.json",
  "title": "KittyEcho runner-only decoder plan v1",
  "description": "Contains ordered audio inputs only; no references, conditions, speakers, or sessions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "plan_id", "run_id", "dataset_id", "model_alias", "pcm_contract_id",
    "decoder_contract_id", "input_transform_id", "public_plan_sha256",
    "manifest_sha256", "clips"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^plan_[0-9a-f]{12}$"},
    "run_id": {"type": "string", "pattern": "^run_[0-9a-f]{12}$"},
    "dataset_id": {"type": "string", "pattern": "^dataset_[0-9a-f]{12}$"},
    "model_alias": {"type": "string", "pattern": "^M[0-9]{3}$"},
    "pcm_contract_id": {"const": "pcm16k-mono-s16le-v1"},
    "decoder_contract_id": {"const": "first-layer-raw-v1"},
    "input_transform_id": {"const": "canonical-pcm-direct-v1"},
    "public_plan_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clip_id", "audio_path", "wav_file_sha256",
          "pcm_payload_sha256", "pcm_payload_bytes"
        ],
        "properties": {
          "clip_id": {"type": "string", "pattern": "^clip_[0-9a-f]{12}$"},
          "audio_path": {"type": "string", "pattern": "^/"},
          "wav_file_sha256": {"$ref": "#/$defs/sha256"},
          "pcm_payload_sha256": {"$ref": "#/$defs/sha256"},
          "pcm_payload_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
