<!--
  Brand icon: black cat with yellow eyes ("弦外小猫" / KittyEcho).
  Full-canvas in-app brand vector. viewBox 0 0 100 100.
  White rounded-rect background + cat (group transform translate(50 51) scale(0.94) translate(-50 -51)).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- white rounded-rect background (rx=24) -->
    <path
        android:fillColor="#ffffff"
        android:pathData="M24,0 L76,0 A24,24 0 0 1 100,24 L100,76 A24,24 0 0 1 76,100 L24,100 A24,24 0 0 1 0,76 L0,24 A24,24 0 0 1 24,0 Z" />

    <group
        android:translateX="50"
        android:translateY="51"
        android:scaleX="0.94"
        android:scaleY="0.94">
        <group
            android:translateX="-50"
            android:translateY="-51">
            <!-- left ear outer -->
            <path android:pathData="M22,42 L29,9 L51,33 Z" android:fillColor="#1b1b1f" />
            <!-- right ear outer -->
            <path android:pathData="M78,42 L71,9 L49,33 Z" android:fillColor="#1b1b1f" />
            <!-- left ear inner (pink) -->
            <path android:pathData="M31,33 L34,17 L44,30 Z" android:fillColor="#F472B6" android:fillAlpha="0.85" />
            <!-- right ear inner (pink) -->
            <path android:pathData="M69,33 L66,17 L56,30 Z" android:fillColor="#F472B6" android:fillAlpha="0.85" />
            <!-- head -->
            <path android:pathData="M85,58 a35,31 0 1,1 -70,0 a35,31 0 1,1 70,0 Z" android:fillColor="#1b1b1f" />
            <!-- left eye (yellow) -->
            <path android:pathData="M45.5,55 a7.5,9.5 0 1,1 -15,0 a7.5,9.5 0 1,1 15,0 Z" android:fillColor="#FDE047" />
            <!-- left pupil -->
            <path android:pathData="M41.7,56 a2.7,5.2 0 1,1 -5.4,0 a2.7,5.2 0 1,1 5.4,0 Z" android:fillColor="#1b1b1f" />
            <!-- left eye glint -->
            <path android:pathData="M37.8,51 a1.5,1.5 0 1,1 -3,0 a1.5,1.5 0 1,1 3,0 Z" android:fillColor="#ffffff" />
            <!-- right eye (yellow) -->
            <path android:pathData="M69.5,55 a7.5,9.5 0 1,1 -15,0 a7.5,9.5 0 1,1 15,0 Z" android:fillColor="#FDE047" />
            <!-- right pupil -->
            <path android:pathData="M65.7,56 a2.7,5.2 0 1,1 -5.4,0 a2.7,5.2 0 1,1 5.4,0 Z" android:fillColor="#1b1b1f" />
            <!-- right eye glint -->
            <path android:pathData="M61.8,51 a1.5,1.5 0 1,1 -3,0 a1.5,1.5 0 1,1 3,0 Z" android:fillColor="#ffffff" />
            <!-- nose/mouth (pink) -->
            <path android:pathData="M46,69 L54,69 L50,74 Z" android:fillColor="#F472B6" />
            <!-- star -->
            <path android:pathData="M80,6 L83,16 L93,19 L83,22 L80,32 L77,22 L67,19 L77,16 Z" android:fillColor="#FCD34D" />
        </group>
    </group>
</vector>
